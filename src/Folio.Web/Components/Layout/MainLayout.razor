@inherits LayoutComponentBase
@using Folio.Application
@using Folio.Domain.Enums
@inject IConfiguration Configuration
@inject CurrentUserOptions CurrentUser

<header class="topbar">
    <div class="topbar-left">
        <button class="menu-toggle" @onclick="ToggleSidebar" aria-label="@(_sidebarCollapsed ? "Show menu" : "Hide menu")" title="@(_sidebarCollapsed ? "Show menu" : "Hide menu")">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
        </button>
        <div class="brand">
            <div class="brand-icon">F</div>
            <span class="brand-name">Folio</span>
        </div>
    </div>
    <div class="topbar-right">
        <div class="user-menu">
            <div class="user-avatar">@_userInitials</div>
            <div class="user-info">
                <div class="user-name">@_displayName</div>
                <div class="user-role">@_userRole</div>
            </div>
        </div>
    </div>
</header>

<div class="app-layout">
    <nav class="sidebar @SidebarClass">
        <div class="sidebar-section-label">Report types</div>

        <NavLink class="nav-item" href="/transfers" Match="NavLinkMatch.All" ActiveClass="active">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
            </svg>
            Player transfers
        </NavLink>

        <NavLink class="nav-item" href="/budgets" ActiveClass="active">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            </svg>
            Budgets
        </NavLink>

        <NavLink class="nav-item" href="/annual" ActiveClass="active">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            Season reports
        </NavLink>

        @if (_canAccessAdmin)
        {
            <div class="sidebar-divider"></div>
            <div class="sidebar-section-label">Management</div>

            <NavLink class="nav-item" href="/admin" ActiveClass="active">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="3"/>
                </svg>
                Administration
            </NavLink>
        }
    </nav>

    <main class="main-content @MainClass">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _sidebarCollapsed;
    private string _displayName = "User";
    private string _userRole = "League office";
    private string _userInitials = "U";
    private bool _canAccessAdmin => RolePermissions.CanAccessAdmin(CurrentUser.AppRole);

    protected override void OnInitialized()
    {
        _displayName = Configuration["CurrentUser:DisplayName"] ?? "Test Testovič";
        _userRole = Configuration["CurrentUser:Role"] ?? "League office · Admin";
        _userInitials = Configuration["CurrentUser:Initials"] ?? "TT";
    }

    // "open" is what the mobile breakpoint reacts to, "collapsed" what the desktop layout uses.
    private string SidebarClass => _sidebarCollapsed ? "collapsed" : "open";
    private string MainClass => _sidebarCollapsed ? "expanded" : "";

    private void ToggleSidebar() => _sidebarCollapsed = !_sidebarCollapsed;
}
