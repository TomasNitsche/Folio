@using Folio.Application.DTOs.Users
@using Folio.Domain.Enums
@inject FolioApiClient Api

@if (Visible)
{
    <div class="modal-overlay open" @onclick="Close"></div>
    <div class="modal-dialog open">
        <div class="modal-header">
            <div>
                <h2>@(IsEdit ? "Edit user" : "Add user")</h2>
                <p>@(IsEdit ? "Update display name, email, and application role." : "Create a new user with access to the application.")</p>
            </div>
            <button class="btn btn-ghost btn-icon" @onclick="Close">✕</button>
        </div>

        <div class="modal-body">
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-error">@_error</div>
            }

            <div class="form-grid form-grid-single">
                @if (!IsEdit)
                {
                    <div class="form-field">
                        <label>User name</label>
                        <input type="text" @bind="_userName" placeholder="e.g. jan.novak" />
                        <span class="form-hint">Login identifier (cannot be changed later)</span>
                    </div>
                }
                else
                {
                    <div class="form-field">
                        <label>User name</label>
                        <input type="text" value="@User?.UserName" disabled />
                    </div>
                }

                <div class="form-field">
                    <label>Display name</label>
                    <input type="text" @bind="_displayName" placeholder="e.g. Jan Novák" />
                </div>

                <div class="form-field">
                    <label>Email</label>
                    <input type="email" @bind="_email" placeholder="jan.novak@example.com" />
                </div>

                <div class="form-field">
                    <label>Role</label>
                    <select @bind="_role">
                        @foreach (var role in Roles)
                        {
                            <option value="@role.Role">@role.Name</option>
                        }
                    </select>
                    @if (_selectedRole is not null)
                    {
                        <span class="form-hint">@_selectedRole.Description</span>
                    }
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button class="btn btn-secondary" @onclick="Close">Cancel</button>
            <button class="btn btn-primary" @onclick="Submit" disabled="@_submitting">
                @(_submitting ? "Saving…" : (IsEdit ? "Save changes" : "Add user"))
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public UserDto? User { get; set; }
    [Parameter] public IReadOnlyList<RoleDefinitionDto> Roles { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string _userName = "";
    private string _displayName = "";
    private string _email = "";
    private UserRole _role = UserRole.Confirmer;
    private bool _submitting;
    private string? _error;

    private bool IsEdit => User is not null;
    private RoleDefinitionDto? _selectedRole => Roles.FirstOrDefault(r => r.Role == _role);

    protected override void OnParametersSet()
    {
        if (!Visible) return;

        if (User is not null)
        {
            _displayName = User.DisplayName;
            _email = User.Email;
            _role = User.Role;
        }
        else
        {
            _userName = "";
            _displayName = "";
            _email = "";
            _role = UserRole.Confirmer;
        }

        _error = null;
    }

    private async Task Submit()
    {
        _submitting = true;
        _error = null;
        try
        {
            if (IsEdit)
            {
                await Api.UpdateUserAsync(User!.Id, new UpdateUserRequest(_displayName, _email, _role));
            }
            else
            {
                await Api.CreateUserAsync(new CreateUserRequest(_userName, _displayName, _email, _role));
            }

            await OnSaved.InvokeAsync();
            await Close();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task Close()
    {
        _error = null;
        await OnClose.InvokeAsync();
    }
}
